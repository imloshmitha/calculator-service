{
  "info": {
    "name": "Calculator API",
    "description": "Requests for the calculator service. `baseUrl` defaults to http://localhost:3000, where Nginx proxies `/api/` and `/health` to the backend. Success responses are `{\"result\": number}`. Errors are `{\"code\", \"message\"}`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('content type is JSON', function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.eql('application/json');",
                  "});",
                  "pm.test('status is ok', function () {",
                  "  pm.expect(pm.response.json()).to.eql({ status: 'ok' });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /health is not allowed",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 405', function () {",
                  "  pm.response.to.have.status(405);",
                  "});",
                  "pm.test('Allow is GET', function () {",
                  "  pm.expect(pm.response.headers.get('Allow')).to.eql('GET');",
                  "});",
                  "pm.test('method not allowed', function () {",
                  "  pm.expect(pm.response.json()).to.eql({",
                  "    code: 'method_not_allowed',",
                  "    message: 'method not allowed'",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
